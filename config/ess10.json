{
  "include": ["ess/common_core.json", "ess/r10_core.json", "ess/r10_democracy.json", "ess/r10_digital.json", "ess/r10_covid.json"],
  "id_column": "idno",
  "essround": 10,
  "contradictions": [
    {"conditions": [
      {"column": "agea", "op": "<=", "value": 30},
      {"column": "yrbrn", "op": "<=", "value": 1985}
    ]},
    {"conditions": [
      {"column": "agea", "op": ">=", "value": 60},
      {"column": "yrbrn", "op": ">=", "value": 1967}
    ]}
  ],
  "weights": {
    "straightlining": 1.0,
    "logical_contradiction": 1.0,
    "mahalanobis_outlier": 1.0
  },
  "mahalanobis_min_scales": 3,
  "flag_threshold": 50
}
