{
  "include": ["ess/common_core.json", "ess/r11_core.json", "ess/r11_health.json", "ess/r11_gender.json"],
  "id_column": "idno",
  "essround": 11,
  "contradictions": [
    {"conditions": [
      {"column": "agea", "op": "<=", "value": 30},
      {"column": "yrbrn", "op": "<=", "value": 1987}
    ]},
    {"conditions": [
      {"column": "agea", "op": ">=", "value": 60},
      {"column": "yrbrn", "op": ">=", "value": 1969}
    ]}
  ],
  "weights": {
    "straightlining": 1.0,
    "logical_contradiction": 1.0,
    "mahalanobis_outlier": 1.0
  },
  "mahalanobis_min_scales": 3,
  "flag_threshold": 50
}
