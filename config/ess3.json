{
  "include": ["ess/common_core.json", "ess/r3_core.json", "ess/r3_timing_of_life.json", "ess/r3_wellbeing.json"],
  "id_column": "idno",
  "essround": 3,
  "contradictions": [
    {"conditions": [
      {"column": "partner", "op": "==", "value": 1},
      {"column": "hhmmb", "op": "==", "value": 1}
    ]},
    {"conditions": [
      {"column": "agea", "op": "<=", "value": 30},
      {"column": "yrbrn", "op": "<=", "value": 1971}
    ]},
    {"conditions": [
      {"column": "agea", "op": ">=", "value": 60},
      {"column": "yrbrn", "op": ">=", "value": 1953}
    ]}
  ],
  "weights": {
    "straightlining": 1.0,
    "logical_contradiction": 1.0,
    "mahalanobis_outlier": 1.0
  },
  "mahalanobis_min_scales": 3,
  "flag_threshold": 50
}
