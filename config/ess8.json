{
  "include": ["ess/common_core.json", "ess/r8_core.json", "ess/r8_climate.json", "ess/r8_welfare.json"],
  "id_column": "idno",
  "essround": 8,
  "contradictions": [
    {"conditions": [
      {"column": "icpart1", "op": "==", "value": 1},
      {"column": "hhmmb", "op": "==", "value": 1}
    ]},
    {"conditions": [
      {"column": "agea", "op": "<=", "value": 30},
      {"column": "yrbrn", "op": "<=", "value": 1981}
    ]},
    {"conditions": [
      {"column": "agea", "op": ">=", "value": 60},
      {"column": "yrbrn", "op": ">=", "value": 1963}
    ]}
  ],
  "weights": {
    "straightlining": 1.0,
    "logical_contradiction": 1.0,
    "mahalanobis_outlier": 1.0
  },
  "mahalanobis_min_scales": 3,
  "flag_threshold": 50
}
